# Copy to .env and fill in only what you need. This file is read by the backend
# only; secrets are never sent to the browser or written to the database/logs.

# Optional: enables the AI search assistant (Claude).
# ANTHROPIC_API_KEY=

# Optional but recommended: free OpenAlex API key (the shared no-key budget is small).
# PAPERFINDER_OPENALEX_API_KEY=

# Optional: Semantic Scholar API key for higher rate limits.
# PAPERFINDER_S2_API_KEY=

# Server (loopback only by default).
# PAPERFINDER_PORT=8000
# PAPERFINDER_ALLOW_LAN=false
# PAPERFINDER_DATA_DIR=./data
